# Copy this file to android/keystore.properties and fill in your own signing
# credentials. Never commit the real keystore or this file.
#
# Generate a keystore:
#   keytool -genkeypair -v -keystore android/piano-studio-release.keystore \
#     -alias piano-studio -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype PKCS12 -storepass <password> -keypass <password> \
#     -dname "CN=Piano Studio, O=Piano Studio, C=HK"
#
# The path is resolved relative to android/app/.
storeFile=../piano-studio-release.keystore
storePassword=CHANGE_ME
keyAlias=piano-studio
keyPassword=CHANGE_ME
